cc_binary {
    name: "android.hardware.sensors-service.sunfish",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.sensors-service.sunfish.rc"],
    vintf_fragments: ["android.hardware.sensors-service.sunfish.xml"],
    srcs: [
        "main.cpp",
        "Sensors.cpp",
        "Ssc.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "libhardware_legacy",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "android.hardware.sensors-V3-ndk",
    ],
}
