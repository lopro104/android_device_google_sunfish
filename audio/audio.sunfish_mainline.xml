    TinyHAL routing for the mainline sm7150 sound card: MultiMedia1
    (PCM 0) is routed to the two CS35L41 speaker amps on SEC_TDM_RX_0.
-->
<audiohal>
    <mixer card="0">
        <init>
            <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia1" val="0" />

            <!--
                Speaker protection: run the Cirrus protection firmware on
                both amps and feed the amplifier from the DSP.
            -->
            <ctl name="L DSP1 Firmware" val="Protection" />
            <ctl name="R DSP1 Firmware" val="Protection" />
            <ctl name="L DSP1 Preload Switch" val="1" />
            <ctl name="R DSP1 Preload Switch" val="1" />
            <ctl name="L PCM Source" val="DSP" />
            <ctl name="R PCM Source" val="DSP" />

            <!-- Stock amplifier gain, safe with the protection firmware -->
            <ctl name="L Analog PCM Volume" val="17" />
            <ctl name="R Analog PCM Volume" val="17" />
        </init>
    </mixer>

    <device name="speaker">
        <path name="on">
            <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia1" val="1" />
        </path>
        <path name="off">
            <ctl name="SEC_TDM_RX_0 Audio Mixer MultiMedia1" val="0" />
        </path>
    </device>

    <!--
        Microphones: RT5514P on TERT_TDM_TX_0. The codec DSP streams them;
        the DMIC switches power the mic LDOs through DAPM.
    -->
    <device name="mic">
        <path name="on">
            <ctl name="Sto1 ADC MIXL DMIC Switch" val="1" />
            <ctl name="Sto2 ADC MIXL DMIC Switch" val="1" />
        </path>
        <path name="off">
            <ctl name="Sto1 ADC MIXL DMIC Switch" val="0" />
            <ctl name="Sto2 ADC MIXL DMIC Switch" val="0" />
        </path>
        <path name="on_pcm_rec">
            <ctl name="MultiMedia1 Mixer TERT_TDM_TX_0" val="1" />
        </path>
        <path name="off_pcm_rec">
            <ctl name="MultiMedia1 Mixer TERT_TDM_TX_0" val="0" />
        </path>
    </device>

    <stream type="pcm" dir="out" card="0" device="0" rate="48000" />
    <stream type="pcm" dir="in" card="0" device="0" rate="48000" period_size="960" period_count="4">
        <enable path="on_pcm_rec" />
        <disable path="off_pcm_rec" />
    </stream>
</audiohal>
