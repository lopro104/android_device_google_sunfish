# The stmfts touch driver hangs if it binds during early boot (it probes before
# its i2c/regulator dependencies are ready and wedges the CPU -> watchdog).
# So it is blocklisted from ueventd auto-load (see modprobe/modules.blocklist)
# and loaded here instead, once userspace is up, where it binds cleanly.
service load-stmfts /system/bin/insmod /vendor_dlkm/lib/modules/stmfts.ko
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:init:s0

# The panel-follower driver (7.1-port) powers the chip from the panel's
# prepare hook instead of probe, which fixed the wedge. Load it before the
# framework starts: EventHub gives up on an input device whose hotplug open
# fails, so it has to be present when EventHub first scans /dev/input.
# Can still be triggered by hand:  adb shell setprop debug.touchtest 1
on post-fs-data
    start load-stmfts

on property:debug.touchtest=1
    start load-stmfts
