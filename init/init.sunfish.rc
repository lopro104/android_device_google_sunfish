import /vendor/etc/init/hw/init.mainline.qcom.rc

# Kernel module loading
on post-fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/modules.load.normal
    trigger start_all_remoteproc

# Mount
on fs
    # Mount everything that does not require fsck
    mount_all --early

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late

# BRINGUP: once hexagonrpcd feeds it, the ADSP's sensor process dies with
# "EF:sensor_process ... sar.cc:27: chre_utils fatal", and the ADSP recovery
# that follows hard-resets the whole phone (~40-110 s after boot). Keep the
# sensors daemon off until that is understood; sensors won't work meanwhile.
on property:init.svc.vendor.hexagonrpcd-adsp-sensorspd=running
    stop vendor.hexagonrpcd-adsp-sensorspd

# zram, as on stock sunfish (init.hardware.rc)
on init
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.sunfish
    write /proc/sys/vm/swappiness 100
