import /vendor/etc/init/hw/init.mainline.qcom.rc

# Kernel module loading
on post-fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/modules.load.normal
    trigger start_all_remoteproc

# Mount
on fs
    # Mount everything that does not require fsck
    mount_all --early

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late

# Sensors PD registry (rebuilt by the DSP from /vendor/etc/sensors/config).
# hexagonrpcd starts before /data is mounted, so restart it once it is.
on post-fs-data
    mkdir /data/vendor/sensors 0770 system system
    mkdir /data/vendor/sensors/registry 0770 system system
    restart vendor.hexagonrpcd-adsp-sensorspd

# zram, as on stock sunfish (init.hardware.rc)
on init
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.sunfish
    write /proc/sys/vm/swappiness 100

# Scheduler tuning after stock init.hardware.rc. Mainline has no schedtune:
# the top-app boost / prefer_idle become uclamp.min / latency_sensitive.
on property:sys.boot_completed=1
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-5,7
    write /dev/cpuset/background/cpus 4-5
    write /dev/cpuset/system-background/cpus 2-5
    write /dev/cpuset/restricted/cpus 2-5
    write /dev/cpuctl/top-app/cpu.uclamp.min 10
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 1
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/rate_limit_us 500

# Factory speaker calibration for the CS35L41 protection firmware
service vendor.speakercal /vendor/bin/init.sunfish.speakercal.sh
    class late_start
    user system
    group system audio
    seclabel u:r:hal_audio_default:s0
    oneshot
    disabled

on property:init.svc.vendor.audio-hal=running
    start vendor.speakercal

# Restart audio after an ADSP crash so remoteproc recovery can finish
service vendor.adspwatch /vendor/bin/init.sunfish.adspwatch.sh
    class late_start
    user root
    group root audio
    seclabel u:r:vendor_init:s0
